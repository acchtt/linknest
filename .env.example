# The app runs in clearly-labelled DEMO MODE without a resolver.
PORT=3000

# Set both for an actual authorized integration (see README for API schema).
RESOLVER_API_URL=
RESOLVER_API_KEY=

# Only trusted HTTPS content delivery domains should be listed.
# If your authorized provider returns media from its own CDN, add that hostname.
MEDIA_HOSTS=fbcdn.net,cdninstagram.com

# Total advertised media size per file, checked when upstream provides Content-Length.
MAX_DOWNLOAD_MB=350
